/* @conductor-contract
{
  "id": "runtime.openai-responses.profiles-v1",
  "objective": "Implement the strict owner-controlled provider profile loader, resolver, canonical fingerprint, and integer micro-USD cost functions in src/contracts/provider-profile.ts. Make the protected provider-profile oracle pass without weakening its schema or embedding any credential.",
  "taskClass": "implementation",
  "adapterId": "kode",
  "adapterOptions": { "model": "main" },
  "scope": {
    "allowedPaths": [
      "src/contracts/provider-profile.ts",
      "config/provider-profiles.example.json"
    ],
    "forbiddenPaths": ["test", "docs", "src/workers", "src/review"],
    "protectedPaths": [
      "AGENTS.md",
      "docs",
      "test",
      "package.json",
      "bun.lock",
      "src/workers/openai-responses.conductor"
    ]
  },
  "contextRefs": [
    "AGENTS.md",
    "docs/openai-responses-worker-design.md",
    "src/contracts/provider-profile.ts",
    "test/provider-profile.test.ts",
    "config/provider-profiles.example.json"
  ],
  "constraints": [
    "The protected test is the owner oracle and must not be changed.",
    "Unknown JSON properties fail; jobs never supply provider-owned model, endpoint, effort, key, rate, or budget fields.",
    "The profile stores only the API-key environment variable name, never the secret value.",
    "Cost is integer micro-USD with cached input and cache-write tokens excluded from ordinary input, and long-context multipliers applied exactly once.",
    "Use no new dependency and preserve strict TypeScript."
  ],
  "escalateWhen": [
    "The protected oracle contradicts the approved design.",
    "Implementation requires widening the provider profile schema or adding a credential to repository data."
  ],
  "setup": [
    {
      "profile": "bun-install",
      "args": [],
      "timeoutMs": 180000
    }
  ],
  "acceptance": [
    {
      "profile": "bun-test",
      "args": ["test/provider-profile.test.ts"],
      "timeoutMs": 60000
    }
  ],
  "timeoutMs": 1200000,
  "retainWorkspace": true,
  "executionBoundary": { "kind": "host-worktree" },
  "dependsOn": [],
  "priority": 30,
  "enabled": true
}
@end-conductor-contract */

