# Core machine-local runtime. Copy this file to the ignored .env.local and
# replace every active placeholder for this machine.
CONDUCTOR_DATA_DIR=C:\Users\YOUR_USER\.conductor\runtime
CONDUCTOR_COMMAND_PROFILES_FILE=Z:\Programmering\Conductor\config\command-profiles.local.json
CONDUCTOR_RESOURCE_PROFILE_FILE=Z:\Programmering\Conductor\config\resource-profile.local.json
CONDUCTOR_MAX_CONCURRENT=2
CONDUCTOR_POLL_INTERVAL_MS=2000
CONDUCTOR_LEASE_MS=30000
CONDUCTOR_SOURCE_POLL_INTERVAL_MS=30000

# OpenAI Responses / Luna route. Keep the key value only in .env.local (or an
# OS-owned secret environment); never place it in the provider-profile JSON.
CONDUCTOR_PROVIDER_PROFILES_FILE=Z:\Programmering\Conductor\config\provider-profiles.local.json
# Optional only when the runner must use another real Bun executable:
# CONDUCTOR_OPENAI_RESPONSES_BUN_BIN=C:\ABSOLUTE\PATH\TO\bun.exe
OPENAI_API_KEY=

# Optional direct llama.cpp / Kode route. Remove these lines on a machine that
# does not run the local worker.
CONDUCTOR_KODE_ENTRY=Z:\Programmering\Kode-CLI\dist\index.js
CONDUCTOR_KODE_NODE_BIN=C:\Program Files\nodejs\node.exe
CONDUCTOR_KODE_MAX_TURNS=16
KODE_CONFIG_DIR=C:\Users\YOUR_USER\.conductor\kode-config
CONDUCTOR_WORKER_ENV_ALLOWLIST=KODE_CONFIG_DIR
CONDUCTOR_MODEL_ENDPOINT=http://127.0.0.1:7332/v1

# Optional worker/verifier bindings.
CONDUCTOR_CODEX_CONFIG_FILE=C:\Users\YOUR_USER\.codex\config.toml
CONDUCTOR_SANDBOX_PROFILES_FILE=Z:\Programmering\Conductor\config\sandbox-profiles.local.json
